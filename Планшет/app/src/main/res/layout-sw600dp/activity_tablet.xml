<?xml version="1.0" encoding="utf-8"?>
<!--
  Екран планшета, альбомний, три колонки:
  ліворуч — вкладки програми і вміст вибраної (Біблія, пісні, показ, плеєр,
  картинки, екран, текст); посередині — сам зал: що зараз на стіні, під ним
  текст залу й передпоказ; праворуч — План та Історія. Знизу — ті самі
  великі кнопки, що й на телефоні, плюс «Порожній».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#101418"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E2A3A"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button android:id="@+id/menuButton" style="@style/TabButton" android:text="☰"
            android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/status"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Вкладки програми — на всю ширину, кожна своєю часткою: усі сім
         видно завжди. Сховане за прокруткою власник назвав недопустимим:
         «если не знать что они там есть … часть функционала теряется». -->
    <LinearLayout
        android:id="@+id/modeTabs"
        android:orientation="horizontal"
        android:background="#16202C"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Ліворуч: вкладки й вміст. -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Біблія: пошук за словами зверху, під ним переклад → книга →
                     розділ → вірші (той самий обозрівач, що в телефоні). -->
                <LinearLayout
                    android:id="@+id/biblePanel"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <EditText
                            android:id="@+id/bibleSearch"
                            android:hint="@string/t_search_hint"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content" />
                        <Button android:id="@+id/bibleSearchGo" style="@style/SmallButton"
                            android:text="@string/t_search_go"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/searchBar"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/searchNote"
                                android:textColor="?android:textColorSecondary"
                                android:textSize="13sp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <Button android:id="@+id/searchClose" style="@style/SmallButton"
                                android:text="@string/t_search_close"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                        <ListView
                            android:id="@+id/searchList"
                            android:divider="#26303C"
                            android:dividerHeight="1dp"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/bibleBar"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/biblePath"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:singleLine="true"
                                android:ellipsize="end"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content" />
                            <Button android:id="@+id/bibleTranslation" style="@style/SmallButton"
                                android:singleLine="true" android:ellipsize="end" android:maxWidth="200dp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/bibleNote"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="13sp"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <ListView
                            android:id="@+id/bibleList"
                            android:divider="#26303C"
                            android:dividerHeight="1dp"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <GridView
                            android:id="@+id/bibleGrid"
                            android:visibility="gone"
                            android:numColumns="auto_fit"
                            android:columnWidth="60dp"
                            android:stretchMode="columnWidth"
                            android:horizontalSpacing="6dp"
                            android:verticalSpacing="6dp"
                            android:paddingTop="6dp"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <LinearLayout
                            android:id="@+id/bibleActions"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <Button android:id="@+id/bibleShow" style="@style/BigButton" android:text="@string/bible_show"
                                android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" />
                            <Button android:id="@+id/bibleClear" style="@style/SmallButton" android:text="@string/bible_clear"
                                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Решта вкладок складається в коді: у кожної свій набір
                     кнопок, а список один. -->
                <LinearLayout
                    android:id="@+id/otherPanel"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:id="@+id/panelTools"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/panelNote"
                        android:textColor="?android:textColorSecondary"
                        android:textSize="13sp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <ListView
                        android:id="@+id/panelList"
                        android:divider="#26303C"
                        android:dividerHeight="1dp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <GridView
                        android:id="@+id/panelGrid"
                        android:visibility="gone"
                        android:numColumns="auto_fit"
                        android:columnWidth="150dp"
                        android:stretchMode="columnWidth"
                        android:horizontalSpacing="6dp"
                        android:verticalSpacing="6dp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                    <LinearLayout
                        android:id="@+id/panelFooter"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Посередині: зал. -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="6dp"
            android:background="#0B0E12"
            android:layout_width="0dp"
            android:layout_weight="5"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/hallCaption"
                android:text="@string/t_hall"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <FrameLayout
                android:background="#000000"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/hallImage"
                    android:scaleType="fitCenter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <ua.church.slovo.remote.PointerView
                    android:id="@+id/pointerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <TextView
                    android:id="@+id/hallNote"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:padding="16dp"
                    android:textColor="#9AA4B2"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>
            <TextView
                android:id="@+id/liveText"
                android:textSize="15sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:paddingTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/previewText"
                android:textSize="13sp"
                android:textColor="?android:textColorSecondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Праворуч: План та Історія. -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button android:id="@+id/tabPlan" style="@style/TabButton" android:text="@string/t_plan"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <Button android:id="@+id/tabHistory" style="@style/TabButton" android:text="@string/t_history"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView
                android:id="@+id/sideNote"
                android:textColor="?android:textColorSecondary"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <ListView
                android:id="@+id/sideList"
                android:divider="#26303C"
                android:dividerHeight="1dp"
                android:choiceMode="singleChoice"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/planTools"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button android:id="@+id/planAdd" style="@style/SmallButton" android:text="@string/t_plan_add"
                    android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" />
                <Button android:id="@+id/planUp" style="@style/SmallButton" android:text="@string/t_up"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <Button android:id="@+id/planDown" style="@style/SmallButton" android:text="@string/t_down"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <Button android:id="@+id/sideRemove" style="@style/SmallButton" android:text="@string/t_remove"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button android:id="@+id/prev" style="@style/BigButton" android:text="@string/prev"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/next" style="@style/BigButton" android:text="@string/next"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/show" style="@style/BigButton" android:text="@string/show"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/hide" style="@style/BigButton" android:text="@string/hide"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/black" style="@style/BigButton" android:text="@string/black"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/blank" style="@style/BigButton" android:text="@string/t_blank"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
