<?xml version="1.0" encoding="utf-8"?>
<!--
  Планшет «Слова»: уся робота служіння з планшета — Біблія, пісні, показ,
  плеєр, картинки, екран, текст, План та Історія, і картинка того, що зараз
  на стіні.

  Окрема програма (ua.church.slovo.tablet), але пакет ресурсів спільний із
  пультом для телефона: код з'єднання, Біблії й указки один на обидві.
  Імена класів повні — вони лежать у пакеті пульта, а не планшета.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ua.church.slovo.remote"
    android:versionCode="9"
    android:versionName="1.8">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Оновлення програми з релізів GitHub: без Google Play інакше ніяк, а
         INSTALL_PACKAGES дають лише системним програмам. Android щоразу
         показує своє вікно згоди. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Slovo"
        android:usesCleartextTraffic="true"
        android:allowBackup="true">

        <activity
            android:name="ua.church.slovo.remote.TabletActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="ua.church.slovo.remote.ConnectActivity"
            android:screenOrientation="landscape"
            android:exported="false"
            android:label="@string/connect_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- План проповіді: складається без зв'язку з програмою. Орієнтація —
             залізно альбомна, як у головного вікна (власник: «не переворачиваться»). -->
        <activity
            android:name="ua.church.slovo.remote.SermonActivity"
            android:exported="false"
            android:label="@string/s_title"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <!-- Ресурси «Слова» з пульта: переклади, пісенники, фони. -->
        <activity
            android:name="ua.church.slovo.remote.ResourcesActivity"
            android:exported="false"
            android:label="@string/resources_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Віддає завантажений .apk встановлювачу: з Android 7 адресу
             file:// іншій програмі давати не можна. -->
        <provider
            android:name="ua.church.slovo.remote.ApkProvider"
            android:authorities="ua.church.slovo.tablet.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
