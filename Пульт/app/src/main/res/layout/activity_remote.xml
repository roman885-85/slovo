<?xml version="1.0" encoding="utf-8"?>
<!-- Екран пульта: зверху слайд презентації або що в залі, посередині
     кнопки, знизу списки. Кнопки великі і внизу-посередині — їх тиснуть
     великим пальцем, не дивлячись. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Своя шапка: название и меню (⋮). -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/app_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/menuButton"
            style="?android:attr/borderlessButtonStyle"
            android:text="⋮"
            android:textSize="22sp"
            android:minWidth="48dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:textColor="?android:textColorSecondary"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Презентація: велика картинка слайда, по якій ведуть указкою, підпис
         і кнопка завантаження файлу з телефону. На цій вкладці блок залу
         схований — куплети й вірші до презентації не стосуються, а місце
         потрібне слайду. -->
    <LinearLayout
        android:id="@+id/showBar"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.8">
        <!-- Картинка і поверх неї пляма указки: те, що під пальцем, видно і
             тут, а не лише на стіні. Дотики ловить картинка. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">
            <ImageView
                android:id="@+id/pageImage"
                android:scaleType="fitCenter"
                android:background="#000000"
                android:contentDescription="@string/pointer_hint"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ua.church.slovo.remote.PointerView
                android:id="@+id/pointerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <!-- Власник: «в пульт добавить кнопку исходного состояния после
                 зума». Видна лише тоді, коли наближення ввімкнене. -->
            <Button
                android:id="@+id/zoomBack"
                android:text="@string/zoom_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/pageCaption"
                android:textColor="?android:textColorSecondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
            <Button android:id="@+id/photoButton" style="@style/SmallButton" android:text="@string/photo"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/uploadButton" style="@style/SmallButton" android:text="@string/upload"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Що зараз у залі — на всіх вкладках, крім презентації. -->
    <LinearLayout
        android:id="@+id/hallBar"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2">
        <TextView
            android:id="@+id/liveReference"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4C8DFF"
            android:paddingTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1A2029"
            android:padding="8dp">
            <TextView
                android:id="@+id/liveText"
                android:textSize="18sp"
                android:lineSpacingExtra="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <TextView
            android:id="@+id/previewText"
            android:textColor="?android:textColorSecondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button android:id="@+id/prev" style="@style/BigButton" android:text="@string/prev"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/next" style="@style/BigButton" android:text="@string/next"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button android:id="@+id/show" style="@style/SmallButton" android:text="@string/show"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/hide" style="@style/SmallButton" android:text="@string/hide"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/black" style="@style/SmallButton" android:text="@string/black"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Вкладки списков. -->
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button android:id="@+id/tabShow" style="@style/TabButton" android:text="@string/tab_show"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/tabPlan" style="@style/TabButton" android:text="@string/tab_plan"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/tabSong" style="@style/TabButton" android:text="@string/tab_song"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/tabBible" style="@style/TabButton" android:text="@string/tab_bible"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/tabSearch" style="@style/TabButton" android:text="@string/tab_search"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Строка ввода: адрес места Писания или слово для поиска песни.
         Показывается только на своих вкладках. -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/input"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />
        <Button android:id="@+id/inputGo" style="@style/SmallButton" android:text="@string/go"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Біблія: шлях і переклад зверху, книги / розділи / вірші посередині,
         «Показати в залі» знизу. Загальний список на цій вкладці схований. -->
    <LinearLayout
        android:id="@+id/bibleBar"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/biblePath"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
            <Button android:id="@+id/bibleTranslation" style="@style/SmallButton"
                android:singleLine="true" android:ellipsize="end" android:maxWidth="170dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:id="@+id/bibleNote"
            android:textColor="?android:textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ListView
            android:id="@+id/bibleList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#26303C"
            android:dividerHeight="1dp" />
        <GridView
            android:id="@+id/bibleGrid"
            android:visibility="gone"
            android:numColumns="auto_fit"
            android:columnWidth="56dp"
            android:stretchMode="columnWidth"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="6dp"
            android:paddingTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:id="@+id/bibleActions"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button android:id="@+id/bibleShow" style="@style/BigButton" android:text="@string/bible_show"
                android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" />
            <Button android:id="@+id/bibleClear" style="@style/SmallButton" android:text="@string/bible_clear"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#26303C"
        android:dividerHeight="1dp" />
</LinearLayout>
