<?xml version="1.0" encoding="utf-8"?>
<!-- Темна тема — та сама, що в «Слові» для Android: програмою користуються в
     затемненому залі, і білий екран сліпить оператора та людей поруч.
     Розкладка складається кодом (див. Ui.java), тут лише вікна. -->
<resources>
    <style name="Theme.Slovo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#141922</item>
        <item name="android:colorPrimaryDark">#0B0E13</item>
        <item name="android:colorAccent">#6C8CFF</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:textColorPrimary">#F3F5F8</item>
        <item name="android:textColorSecondary">#93A0B4</item>
        <item name="android:statusBarColor">#0B0E13</item>
        <item name="android:navigationBarColor">#10141B</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
    </style>

    <!-- Вікно, що виїжджає знизу: вибір зі списку, запитання, поле вводу. -->
    <style name="Theme.Slovo.Sheet" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:colorAccent">#6C8CFF</item>
        <item name="android:windowAnimationStyle">@style/SheetMotion</item>
    </style>
    <style name="SheetMotion">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
    <!-- Сторінка на весь екран зі стрілкою «назад»: налаштування, ресурси. -->
    <style name="Theme.Slovo.Page" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#6C8CFF</item>
        <item name="android:statusBarColor">#0B0E13</item>
        <item name="android:navigationBarColor">#0B0E13</item>
        <item name="android:windowAnimationStyle">@style/PageMotion</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
    </style>
    <style name="PageMotion">
        <item name="android:windowEnterAnimation">@anim/page_in</item>
        <item name="android:windowExitAnimation">@anim/page_out</item>
    </style>
</resources>
